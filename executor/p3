#!/usr/bin/env parser3

@main[]
$result[]

^__executor__:run[]



@CLASS
__executor__


@OPTIONS
static
locals


@auto[filespec]
$self.filespec[$filespec]
$self.separator[^for[](1;100){-}]
$self.history[^file:justname[$filespec]-history.log]
$self.args[^self.parse_args[$request:argv]]

^if(def $self.args.root){
	$request:document-root[$self.args.root]
}


@parse_args[args]
$result[^hash::create[]]

^args.foreach[index;arg]{
	^if(^arg.left(1) eq '-'){
		$result.[^arg.mid(1)][$args.[^eval($index + 1)]]
	}
}


@run[]
$self.buffer[]

^self.version[]
^self.print[$separator^#0A]

^while(true){
	$command[^console:line.trim[end;^#0D^#0A]]
	$commands[^command.split[ ;h]]

	^if(def $commands.0){
		^switch[$commands.0]{
			^case[@help;@h]{
				^self.help[]
			}
			^case[@clear;@c]{
				^self.clear[]
			}
			^case[@version;@v]{
				^self.version[]
			}
			^case[@info;@i]{
				^self.info[]
			}
			^case[@fork;@f]{
				^main[]
			}
			^case[@exit;@e]{
				^self.exit[]
			}
			^case[@]{
				^self.exec(^commands.1.int(1))
			}
			^case[DEFAULT]{
				$self.buffer[${self.buffer}$command^#0A]
			}
		}
	}{
		$self.buffer[${self.buffer}^#0A]
	}
}


@print[string]
$console:line[^string.replace[\n;^#0A]]


@print_exception[exception;stack]
^self.print[$self.separator]
^self.print[Unhandled Exception (Debug)]
^self.print[$exception.type]

^if(def $exception.source){
	^self.print[]
	^self.print[$exception.file ($exception.lineno)]
	^self.print[$exception.source]
	^self.print[$exception.comment]
}

^if($stack){
	^self.print[]

	^stack.foreach[;item]{
		^self.print[$item.name $item.file^($item.line^)]
	}
}

^self.print[$self.separator]


@pad[string;padding]
$result[$string^for[](0;$padding - ^string.length[] - 1){ }]


@help[]
^self.print[Parser3 interactive executor]
^self.version[]

^self.print[
Commands
$self.separator
^@ ...          execute entered code (number of runs in optional argument)
^@help    or @h display this help
^@version or @v display parser version
^@info    or @i display environment information
^@clear   or @c clear input buffer
^@fork    or @f clone executor
^@exit    or @e exit from executor
$self.separator
]


@info[]
$env[$env:fields]
$padding(0)

^env.sort[field;]{$field}

^env.foreach[field;value]{
	$length(^field.length[])

	^if($length > $padding){
		$padding($length)
	}
}

^self.print[Document root]
^self.print[$self.separator]
^self.print[$request:document-root]
^self.print[$self.separator]

^self.print[Environment]
^self.print[$self.separator]
^env.foreach[field;value]{
	^if(def $field){
		^self.print[^self.pad[$field]($padding)  $value]
	}
}
^self.print[$self.separator]


@version[]
^self.print[Parser $env:PARSER_VERSION]


@exec[runs]
^try{
	$main[^math:uid64[]]
	$self.buffer[^untaint[as-is]{$self.buffer}]

	$result[^process[$MAIN:CLASS]{$self.buffer}[
		$.main[$main]
		$.file[$self.filespec]
		$.replace(true)
	]]

	^if($MAIN:$main is junction){
		$stat[^self.usage{
			^for[](1;$runs){
				$result[^MAIN:$main[]]
			}
		}]
	}
}{
	$exception.handled(true)

	$result[]

	^self.print_exception[$exception;^reflection:stack[]]
}

^if(!($result is void)){
	$result[^json:string[$result;$.indent(true)]]
}

^self.print[]
^self.print[$result]
^self.print[^#0A$self.separator]
^self.print[runs: $runs | utime: ^stat.utime.format[%.6f] | stime: ^stat.stime.format[%.6f] | used: $stat.used | allocated since start: ^stat.ever_allocated_since_start.format[%.2f]]
^self.print[$self.separator]

^self.print[]

$history[^self.ts[]^#0A
$self.buffer
$result
$self.separator
]
^history.save[append;$self.history]

$self.buffer[]
^memory:compact[]


@usage[code]
$before[^self.snapshot[]]

$code

$after[^self.snapshot[]]
$result[^self.delta[$before;$after]]

$time($result.time / 1000000)
$result.time[^time.format[%.6f]]


@snapshot[]
$r[$status:rusage]
$m[$status:memory]

$result[
	$.utime($r.utime)
	$.stime($r.stime)
	$.used($m.used)
	$.ever_allocated_since_start($m.ever_allocated_since_start)
]


@delta[before;after]
$result[^hash::create[]]

^before.foreach[field;begin]{
	$result.$field($after.$field - $begin)
}


@ts[][result]
$now[^date::now[]]

^now.sql-string[]


@clear[]
$self.buffer[]
$self.result[$void]

^self.print[$separator]


@exit[]
^self.print[Bye]

^break[]